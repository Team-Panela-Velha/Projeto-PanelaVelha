# Copie para .env (não versionado) e troque as senhas: cp .env.example .env
# Lido pelos scripts de infra/swarm: o deploy.sh cria os Docker secrets do cluster a partir dele.

# Senha do root do MySQL
MYSQL_ROOT_PASSWORD=troque-root
# Usuário da aplicação (criado pela imagem MySQL com acesso ao db_panela_velha)
DB_USER=panela
DB_PASSWORD=troque-app
# Usuário somente leitura 'visitante' do banco
VISITANTE_PASSWORD=troque-visitante
# Chave de assinatura dos tokens JWT (gere uma com: openssl rand -hex 32)
SECRET_KEY=troque-por-uma-chave-aleatoria
# Senha do usuário admin do Portainer no cluster Swarm (mínimo 12 caracteres)
PORTAINER_PASSWORD=troque-portainer-123

# Portas no host, publicadas pelo manager do cluster (infra/swarm/dind-up.sh)
APP_PORT=80
VISUALIZER_PORT=8080
PORTAINER_PORT=9000

# Prefixo/tag das imagens (o registry do cluster fica em 127.0.0.1:5000)
REGISTRY=127.0.0.1:5000
TAG=latest
